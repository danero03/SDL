# Интервал опроса (секунды) — 5 минут
DB_PING_INTERVAL=300

# Логин / пароль для подключения к Postgres
DB_USER=erik
DB_PASSWORD=erikcoolboy

# Путь к файлу логов внутри контейнера
LOG_FILE=/logs/pinger.log

# Путь до config.json внутри контейнера (оставляем стандартный)
DB_CONFIG_PATH=/app/config.json
